APP_NAME=Arbitrage Terminal API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

POSTGRES_DB=arbitrage_terminal
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arbitrage:change_me@postgres:5432/arbitrage_terminal

BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

MARKET_TYPE=perpetual
MONITORING_INTERVAL_SECONDS=10
DEFAULT_SPREAD_THRESHOLD_PERCENT=0.5
NOTIFICATION_COOLDOWN_SECONDS=300
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

